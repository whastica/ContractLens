# ═══════════════════════════════════════════════════════════════
# ContractLens — Variables de entorno
# INSTRUCCIONES:
#   1. cp .env.example .env.local
#   2. Rellena los valores según la fase en la que estés
#   3. NUNCA subas .env.local a git
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature Flags ─────────────────────────────────────────────
# IMPORTANTE: En producción, ambas deben ser "false"
# USE_MOCK_AI=true   → usa datos de prueba sin llamar a OpenAI
# USE_MOCK_DB=true   → no guarda en Supabase
USE_MOCK_AI=true
USE_MOCK_DB=true

# ── Configuración IA ──────────────────────────────────────────
AI_TEMPERATURE=0.3
OPENAI_MODEL=gpt-4o-mini

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Clerk Auth ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ── Upstash Redis (OBLIGATORIO en producción) ──────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── ContractLens ──────────────────────────────────────────────
MAX_CONTRACT_SIZE_MB=25
